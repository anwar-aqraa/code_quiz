from questions import (
    load_questions,
    get_categories,
    filter_questions,
    filter_by_difficulty
)

from user import (
    login,
    update_user,
    show_profile
)

from datetime import datetime
from quiz import start_quiz
from score import save_score, show_scores, show_statistics


def show_menu():
    print("\n========== CodeQuiz ==========")
    print("1. Start Quiz")
    print("2. My Profile")
    print("3. My History")
    print("4. Categories")
    print("5. High Scores")
    print("6. Statistics")
    print("7. Exit")


def choose_category(questions):

    categories = get_categories(questions)

    print("\nChoose Category")

    for index, category in enumerate(categories):
        print(f"{index + 1}. {category}")

    print(f"{len(categories)+1}. Mixed")

    choice = int(input("\nYour choice: "))

    if choice == len(categories)+1:
        return questions, "Mixed"

    selected = categories[choice-1]

    return filter_questions(
        questions,
        selected
    ), selected




def choose_difficulty(questions):

    print("\nChoose Difficulty")

    print("1. 🟢 Easy")
    print("2. 🟡 Medium")
    print("3. 🔴 Hard")
    print("4. Mixed")


    choice = input("\nYour choice: ")


    if choice == "1":
        return filter_by_difficulty(
            questions,
            "easy"
        )

    elif choice == "2":
        return filter_by_difficulty(
            questions,
            "medium"
        )

    elif choice == "3":
        return filter_by_difficulty(
            questions,
            "hard"
        )

    else:
        return questions




def main():

    print("""
=================================
      Welcome to CodeQuiz
=================================
""")

    questions = load_questions()

while True:

    show_menu()

    choice = input("\nChoose option: ")

    if choice == "1":

        category = "Mixed"

        current_user["favorite_category"] = category

        selected_questions, category = choose_category(
            questions
        )

        selected_questions = choose_difficulty(
            selected_questions
        )

        score = start_quiz(
            selected_questions
        )

        save_score(
            current_user["username"],
            category,
            score
        )

        current_user["total_games"] += 1
        current_user["total_score"] += score

        current_user["average_score"] = (
            current_user["total_score"]
            / current_user["total_games"]
        )

        if score > current_user["best_score"]:
            current_user["best_score"] = score

        from datetime import datetime

        current_user["history"].append({
            "category": category,
            "score": score,
            "date": datetime.now().strftime("%Y-%m-%d %H:%M")
        })

        update_user(current_user)

    elif choice == "2":

        show_profile(current_user)

    elif choice == "3":

        show_history(current_user)

    elif choice == "4":

        print("\nAvailable Categories:")

        for category in get_categories(questions):
            print("-", category)

    elif choice == "5":

        show_scores()

    elif choice == "6":

        show_statistics()

    elif choice == "7":

        print("Bye 👋")
        break

    else:

        print("Invalid option!")
if __name__ == "__main__":
    main()
